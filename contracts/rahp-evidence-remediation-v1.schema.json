{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rahp.invalid/schemas/rahp-evidence-remediation-v1.schema.json",
  "title": "RAHP evidence remediation plan v1",
  "type": "object",
  "required": ["schema", "status", "reason_code", "requirements", "rerun_policy"],
  "properties": {
    "schema": {"const": "rahp-evidence-remediation/v1"},
    "status": {"enum": ["required", "model-gap"]},
    "reason_code": {"enum": ["evidence-required", "model-gap", "wrong-evidence-class", "provenance-insufficient"]},
    "plan_digest": {"type": "string", "minLength": 1},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "proposition", "acceptance_criterion", "routing_target"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "proposition": {"type": "string", "minLength": 1},
          "evidence_class": {"type": "string"},
          "producer": {"type": "string"},
          "context_boundary": {"type": "string"},
          "required_fields": {"type": "array", "items": {"type": "string"}},
          "privacy_safe_capture_rule": {"type": "string"},
          "acceptance_criterion": {"type": "string", "minLength": 1},
          "rerun_target": {"type": "string"},
          "priority": {"type": "string"},
          "routing_target": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "rerun_policy": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
