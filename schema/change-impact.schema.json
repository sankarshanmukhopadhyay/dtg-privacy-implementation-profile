{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dpip/change-impact.schema.json",
  "title": "DPIP Portfolio Change Impact Registry",
  "type": "object",
  "required": ["version", "dependencies"],
  "properties": {
    "version": {"type": "string"},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "repository", "area", "impact_types", "affects", "revalidation"],
        "properties": {
          "id": {"type": "string", "pattern": "^DEP-[0-9]{3}$"},
          "repository": {"type": "string"},
          "area": {"type": "string"},
          "specification_or_path": {"type": "string"},
          "impact_types": {
            "type": "array",
            "items": {"enum": ["semantics", "interface", "construction", "deployment", "evidence", "observer-model", "lifecycle"]},
            "minItems": 1,
            "uniqueItems": true
          },
          "affects": {
            "type": "object",
            "properties": {
              "interactions": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]+$"}},
              "requirements": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]+-R[0-9]+$"}},
              "tests": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]+-T[0-9]+$"}},
              "claims": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]+-PC-[0-9]+$"}},
              "flows": {"type": "array", "items": {"type": "string", "pattern": "^RF-[0-9]{3}$"}}
            },
            "additionalProperties": false
          },
          "revalidation": {"enum": ["required", "review-required", "evidence-refresh", "informational"]},
          "reason": {"type": "string"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
