{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dpip/observation-fixture.schema.json",
  "title": "DPIP Executable Observation Fixture",
  "type": "object",
  "required": ["version", "interaction_id", "implementation", "provenance", "vectors"],
  "properties": {
    "version": {"type": "string"},
    "interaction_id": {"type": "string", "pattern": "^C[0-9]+$"},
    "implementation": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "deployment": {"type": "string"}},
      "additionalProperties": false
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source"],
        "properties": {"id": {"type": "string"}, "source": {"type": "string"}, "version": {"type": "string"}, "digest": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "relationship"],
        "properties": {"id": {"type": "string"}, "relationship": {"enum": ["unrelated", "related", "same-context", "unknown"]}, "description": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "observed_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "task_id", "context_id", "observer", "component", "surface", "state", "retention_stage"],
        "properties": {
          "id": {"type": "string"}, "task_id": {"type": "string"}, "context_id": {"type": "string"},
          "observer": {"type": "string"}, "component": {"type": "string"}, "surface": {"type": "string"},
          "state": {"enum": ["observed", "absent", "not-available"]}, "value": {}, "value_digest": {"type": "string"},
          "stability": {"type": "string"}, "retention_stage": {"type": "string"},
          "declared_scope": {"type": "string"}, "observable_scope": {"type": "string"}, "effective_scope": {"type": "string"},
          "provenance_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "join_attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "context_ids", "input_observation_ids", "basis", "result", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "context_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}, "uniqueItems": true},
          "input_observation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "basis": {"type": "string", "minLength": 1},
          "result": {"enum": ["joined", "not-joined", "indeterminate", "not-run"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "explanation": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "vectors": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "test_id"],
        "properties": {
          "id": {"type": "string"}, "test_id": {"type": "string", "pattern": "^C[0-9]+-T[0-9]+$"},
          "crypto_verified": {"type": "boolean"}, "disclosed_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "original_context_verified": {"type": "boolean"}, "changed_context_verified": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
