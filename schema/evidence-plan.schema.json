{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dpip/evidence-plan.schema.json",
  "title": "DPIP Evidence Acquisition Plan",
  "type": "object",
  "required": ["version", "source_issue", "setup_digest", "contexts", "acquisition_tasks", "join_attempts", "judgment_boundary"],
  "properties": {
    "version": {"type": "string"},
    "source_issue": {"type": "integer", "minimum": 1},
    "setup_digest": {"type": "string", "minLength": 8},
    "source_pins": {"type": "array", "items": {"type": "object"}},
    "candidate_interactions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "candidate_profiles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "candidate_claims": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "candidate_invariants": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "contexts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "role", "relationship"],
        "properties": {
          "id": {"type": "string"},
          "role": {"type": "string"},
          "relationship": {"enum": ["unrelated", "related", "same-context", "unknown"]}
        },
        "additionalProperties": false
      }
    },
    "acquisition_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "surface", "component", "observer", "contexts", "retention_stage", "availability", "falsification_purpose"],
        "properties": {
          "id": {"type": "string", "pattern": "^EA-[A-Z0-9-]+$"},
          "surface": {"type": "string"},
          "component": {"type": "string"},
          "observer": {"type": "string"},
          "contexts": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "retention_stage": {"type": "string"},
          "availability": {"enum": ["available", "missing", "not-applicable", "unknown"]},
          "falsification_purpose": {"type": "string", "minLength": 1},
          "collector": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "join_attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "task_ids", "contexts", "basis", "expected_question"],
        "properties": {
          "id": {"type": "string"},
          "task_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "contexts": {"type": "array", "minItems": 2, "items": {"type": "string"}, "uniqueItems": true},
          "basis": {"type": "string", "minLength": 1},
          "expected_question": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "unresolved_requirements": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["ready", "needs-review"]},
    "judgment_boundary": {
      "type": "object",
      "required": ["applicability", "privacy_judgment", "human_acceptance_required"],
      "properties": {
        "applicability": {"const": "not-made"},
        "privacy_judgment": {"const": "not-made"},
        "human_acceptance_required": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
