{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dpip/evidence-binding.schema.json",
  "title": "DPIP External Evidence Binding Registry",
  "type": "object",
  "required": ["dpip_version", "interaction_id", "bindings"],
  "properties": {
    "dpip_version": {"type": "string"},
    "interaction_id": {"type": "string", "pattern": "^C[0-9]+$"},
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "maturity", "repository", "artifact", "evidence_kind", "supports", "scope", "limitations"],
        "properties": {
          "id": {"type": "string", "pattern": "^EV-C[0-9]+-[0-9]+$"},
          "maturity": {"enum": ["candidate", "verified", "superseded"]},
          "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "revision": {"type": "string"},
          "released_tag": {"type": "string"},
          "artifact": {
            "type": "object",
            "required": ["kind", "locator"],
            "properties": {
              "kind": {"enum": ["path", "issue", "pull-request", "test-vector", "generated-evidence", "spec-section", "commit"]},
              "locator": {"type": "string"}
            },
            "additionalProperties": false
          },
          "evidence_kind": {"enum": ["construction", "semantic", "protocol-interface", "implementation", "adversarial", "deployment", "governance"]},
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["target_type", "target_id"],
              "properties": {
                "target_type": {"enum": ["test", "privacy-claim", "requirement"]},
                "target_id": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "scope": {
            "type": "object",
            "required": ["subject", "statement"],
            "properties": {
              "subject": {"enum": ["identifier", "credential-half", "relationship", "presentation", "contextual-graph", "proof-construction", "protocol-envelope", "deployment"]},
              "statement": {"type": "string"}
            },
            "additionalProperties": false
          },
          "limitations": {"type": "array", "items": {"type": "string"}},
          "owner_normative_status": {"enum": ["normative", "informative", "experimental", "unknown"]},
          "provenance": {
            "type": "object",
            "properties": {
              "captured_from": {"type": "string"},
              "digest": {"type": "string"},
              "notes": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
